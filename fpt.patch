-pub fn add_with_carry<T: UnsignedInteger>(l: T, r: T, c: bool) -> (T, bool) {
-    let (lr, o0) = l.overflowing_add(r);
-    let (lrc, o1) = lr.overflowing_add(T::cast_from(c));
