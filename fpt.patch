-pub fn add_assign_words<T: UnsignedInteger>(lhs: &mut [T], rhs: &[T]) {
-    let iter = lhs
-        .iter_mut()
-        .zip(rhs.iter().copied().chain(std::iter::repeat(T::ZERO)));
-
-    let mut carry = false;
-    for (lhs_block, rhs_block) in iter {
-        let (result, out_carry) = add_with_carry(*lhs_block, rhs_block, carry);
-        *lhs_block = result;
